manifest {
    name            = 'wastewater-proteomics-nf'
    description     = 'Lightweight shotgun proteomics pipeline for wastewater-based epidemiology'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    help              = false
    // input
    pride             = null
    samplesheet       = null
    test_data         = false
    max_files         = 6
    max_file_mb       = 3000
    include_regex     = null
    group_regex       = null
    // database
    fasta             = null
    taxmap            = null
    proteomes         = "${projectDir}/assets/proteomes.tsv"
    db_set            = 'minimal'
    contaminants      = 'true'
    // search
    missed_cleavages  = 2
    precursor_ppm     = 10
    fragment_ppm      = 20
    carbamidomethyl   = 'true'
    oxidation         = 'true'
    min_matched_peaks = 4
    // analysis
    fdr               = 0.01
    min_peptides      = 2
    panel             = "${projectDir}/assets/biomarker_panel.tsv"
    report_title      = 'Wastewater proteomics report'
    // executables (override if installed elsewhere)
    sage_bin          = 'sage'
    trfp_bin          = 'thermorawfileparser'
    // resources
    max_cpus          = 4
    max_memory        = '12 GB'
    outdir            = 'results'
}

process {
    cpus   = 1
    memory = '2 GB'
    withLabel: 'convert' { cpus = 1; memory = '4 GB'; maxForks = 2 }
    withLabel: 'sage'    { cpus = { params.max_cpus as int }; memory = { params.max_memory as nextflow.util.MemoryUnit } }
    withLabel: 'python'  { memory = '4 GB' }
}

profiles {
    test {
        params.test_data         = true
        params.oxidation         = 'false'
        params.carbamidomethyl   = 'false'
        params.min_matched_peaks = 2
        params.max_cpus          = 2
        params.max_memory        = '2 GB'
        params.outdir            = 'results_test'
        params.report_title      = 'Synthetic test data (not real wastewater)'
    }
    conda {
        conda.enabled  = true
        process.conda  = "${projectDir}/environment.yml"
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
        process.conda  = "${projectDir}/environment.yml"
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_report.html" }
